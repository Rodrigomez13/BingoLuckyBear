{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "experimentalServices": {
    "frontend": {
      "entrypoint": ".",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "paddle-ocr": {
      "entrypoint": "services/paddle-ocr",
      "routePrefix": "/paddle-ocr",
      "framework": "fastapi"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "luckybingbear.com"
        }
      ],
      "destination": "https://www.luckybingbear.com/:path*",
      "permanent": true
    }
  ]
}
