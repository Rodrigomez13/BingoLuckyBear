{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "framework": "nextjs",
  "devCommand": "pnpm run dev",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "luckybingbear.com"
        }
      ],
      "destination": "https://www.luckybingbear.com/:path*",
      "permanent": true
    }
  ]
}
